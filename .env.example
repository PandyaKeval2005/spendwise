# ==========================================
# SpendWise Environment Variables Configuration
# Duplicate this file as '.env' for local development
# NEVER commit your actual '.env' with real secrets to GitHub
# ==========================================

# 1. Server Configuration
PORT=5000
NODE_ENV=production

# 2. Authentication Secret (CRITICAL: Must be a long, random secure string in production)
JWT_SECRET=your_super_secret_jwt_random_key_min_32_characters_here

# 3. Frontend API Base URL
# - In local development: leave blank or set to http://localhost:5000/api
# - On Vercel:
#   * If using Vercel rewrites or serverless function: leave blank (defaults to /api)
#   * If hosting backend on Render / Railway: set to https://your-backend-service.onrender.com/api
VITE_API_URL=

# 4. Optional Cloud Database: Supabase / PostgreSQL Configuration
# If connecting to hosted Supabase PostgreSQL database:
# SUPABASE_URL=https://your-project-id.supabase.co
# SUPABASE_ANON_KEY=your_supabase_anon_public_key
# DATABASE_URL=postgresql://postgres:your_password@db.your-project-id.supabase.co:5432/postgres
